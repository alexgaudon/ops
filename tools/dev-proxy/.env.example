# dev-proxy
# Copy to .env and fill in your values. Do not commit .env.

# Apophis is the default. Set PREVIEW_BACKEND=npm for the old .dev.amgau.xyz workflow.
PREVIEW_BACKEND=apophis
PREVIEW_INTERNAL_TOKEN=

# Legacy fallback: nginx-proxy-manager admin API
NPM_BASE_URL=http://10.0.0.20:81

# Use a permanent API token from NPM (Account Settings -> Tokens).
# This is preferred over email/password, especially with 2FA on.
NPM_TOKEN=

# ...or use NPM admin credentials (fallback when NPM_TOKEN is empty)
NPM_EMAIL=
NPM_PASSWORD=

# Which DNS provider handles the preview domain (amgau.xyz is on Porkbun).
# Options: porkbun | cloudflare
DNS_PROVIDER=porkbun

# Porkbun API credentials (api-key and secret-api-key from porkbun.com -> API)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Cloudflare API token, used only when DNS_PROVIDER=cloudflare.
# The CLI also accepts the short names CF_TOKEN / PORKBUN_KEY / PORKBUN_SECRET.
CLOUDFLARE_API_TOKEN=

# Preview naming: <name>.<PREVIEW_DOMAIN> with no input ambiguity.
PREVIEW_DOMAIN=dev.amgau.xyz

# This machine's LAN address (where preview services run).
PREVIEW_HOST=10.0.0.49
