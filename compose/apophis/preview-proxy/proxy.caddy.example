# Import this snippet on both Caddys. Do not mount it in the live import glob until ready.
(preview_proxy) {
	route {
		request_header -X-Preview-Upstream
		forward_auth preview-lookup:8000 {
			uri /resolve/{args[0]}
			header_up X-Preview-Host {host}
			copy_headers X-Preview-Upstream
		}
		@resolved header X-Preview-Upstream *
		reverse_proxy @resolved {http.request.header.X-Preview-Upstream} {
			header_up -X-Preview-Upstream
			header_up -X-Preview-Host
			header_up -{args[1]}
		}
		respond 404
	}
}

