proxmox.internal.misery.systems {
	import internal_ui_tls

	@lan remote_ip 10.0.0.0/24
	handle @lan {
		reverse_proxy https://10.0.0.6:8006 https://10.0.0.7:8006 https://10.0.0.8:8006 {
			# Keep console tickets and WebSocket requests on the selected node.
			lb_policy cookie proxmox_node {
				fallback first
			}
			lb_try_duration 5s
			health_uri /
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			transport http {
				dial_timeout 2s
				tls_trust_pool file /etc/caddy/trust/proxmox-cluster-ca.pem
			}
		}
	}
	handle {
		respond 403
	}
}
