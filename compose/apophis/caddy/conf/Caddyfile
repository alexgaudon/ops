# Edge reverse proxy for the compose host.
# TLS via Let's Encrypt DNS-01 (Cloudflare), so certificates issue
# without any inbound access to this host.

import private/*.caddy
import routes/*.caddy

# --- migrated to this host ----------------------------------------------------

misery.systems {
	reverse_proxy misery-systems-web:4321
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
}

lootsheet.app {
	reverse_proxy lootsheet:8090
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
}

# --- external backends, previously proxied through the cluster ----------------

jellyfin.misery.systems {
	reverse_proxy 10.0.0.5:8096
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
}

# Keep saved clients working without redirecting them to the preferred name.
jellyfin.amgau.com {
	# The old proxy restricts metrics. Keep them off this compatibility route.
	@metrics path /metrics /metrics/*
	respond @metrics 403
	header {
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection 0
		X-Content-Type-Options nosniff
	}
	reverse_proxy 10.0.0.5:8096
	tls {
		dns cloudflare {env.CLOUDFLARE_AMGAU_DNS_API_TOKEN}
	}
}

jellyseer.misery.systems {
	reverse_proxy 10.0.0.5:5055
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
}

# Keep the old requests URL working without a redirect.
jellyseer.amgau.com {
	reverse_proxy 10.0.0.5:5055
	tls {
		dns cloudflare {env.CLOUDFLARE_AMGAU_DNS_API_TOKEN}
	}
}
